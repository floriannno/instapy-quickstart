# Deployer / relayer key (never commit the real .env)
PRIVATE_KEY=0x...

# Robinhood Chain RPCs
ROBINHOOD_TESTNET_RPC=https://rpc.testnet.chain.robinhood.com
ROBINHOOD_MAINNET_RPC=https://rpc.mainnet.chain.robinhood.com

# Addresses used by scripts/deploy.js
DETECTOR_SIGNER=0x...        # public address of the key inside detector/.env
TEAM_WALLET=0x...            # receives the vested team allocation
COMMUNITY_WALLET=0x...       # receives the vested detector-network allocation

# Buyback executor (choose one after deploy, see scripts/set-executor.js)
UNISWAP_V2_ROUTER=
UNISWAP_V3_ROUTER=
WETH=
V3_POOL_FEE=3000
