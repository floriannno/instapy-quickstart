RPC_URL=https://rpc.testnet.chain.robinhood.com
ORACLE_ADDRESS=0x...            # from deployments/<network>.json
DETECTOR_ID=1
DETECTOR_PRIVATE_KEY=0x...      # key whose address was passed as DETECTOR_SIGNER at deploy
RELAYER_PRIVATE_KEY=            # optional: pays gas; defaults to the detector key

SERIAL_PORT=/dev/ttyUSB0        # CosmicWatch USB serial
BAUD=9600
MIN_ADC=0                       # 0 = read threshold from the oracle
LOCAL_COOLDOWN=0                # extra seconds to sleep after a relayed hit
EVENTS_LOG=./events.jsonl

# Optional slippage quote for the buyback (V2-style router only)
QUOTE_V2_ROUTER=
WETH=
TOKEN_ADDRESS=
VAULT_ADDRESS=
SLIPPAGE_BPS=300
